# Copy to .env.local for local development. Never commit real secrets.
# Leave a variable empty when that service is not set up.

# postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
# Required on Netlify. Locally, an empty value uses an embedded Postgres file in .data/
DATABASE_URL=

# public site origin, no trailing slash. Example: http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Comma-separated origins allowed to call this app. Example: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Auth.js-style session pepper. Use a long random string in any shared environment.
AUTH_SECRET=

# First business admin can be created in the browser while no users exist.
# Set this only for an emergency local bootstrap. Leave blank to use the setup screen.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# Stripe. Use test keys (sk_test_, pk_test_) until the owner enables live payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Maps. Restrict the browser key by HTTP referrer. Leave blank to show status text only.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_SERVER_KEY=

# Email and SMS are not sent until a provider and sender are configured.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
SMS_PROVIDER=
SMS_API_KEY=
SMS_FROM=

# Optional object storage for private documents. Public menu images are not required.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# Driver location points older than this many days are deleted. Default 7.
LOCATION_RETENTION_DAYS=7

# Asia/Dubai is the business time zone and is not overridden by this file.
BUSINESS_TIME_ZONE=Asia/Dubai
