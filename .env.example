# Set these in Netlify → Site configuration → Environment variables, never in this file.
# ADMIN_PASSWORD=            password for /admin
# STRIPE_SECRET_KEY=         sk_test_... or sk_live_...  (turns on "Pay online by card")
# STRIPE_WEBHOOK_SECRET=     whsec_...  (optional, for /api/stripe/webhook)
# SESSION_SECRET=            optional long random text for login tokens
